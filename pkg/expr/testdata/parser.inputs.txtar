-- simple-string --
foobar
-- multiline-string --
foo
bar
-- single-eval-expr --
${{ 2/3}}
-- eval-with-strings --
foo ${{ bar }} baz ${{fizz}}
-- shell-with-eval --
$(chown ${{env.USER}} -R $PWD)
-- errors --
-- err-nested-eval --
${{ ${{ foo }} }}
-- err-shell-in-eval --
${{ foo $( ls -la ) }}
-- err-shell-in-shell --
$($())
-- err-eval-syntax-err --
prefix ${{ foo( }} with $(suffix)
-- end --