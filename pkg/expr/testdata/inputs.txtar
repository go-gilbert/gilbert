-- simple-string --
foobar
-- multi-line-string --
foo
bar
-- multi-line-string-with-eol --
foo

bar
-- single-expr --
${{ 2 + 2 }}
-- single-shell-expr --
$(ls -la /)
-- string+shell --
hello $(whoami)
-- string+eval --
hello ${{ 2 / 0 }}
-- string+eval+string --
foo ${{bar}} baz
-- eval+str --
${{2+2}} foobar
-- eval+lf+str --
${{2+2}}
foobar
-- eval+lf+str-input --
-- end --